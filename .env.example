# AI-CRM mono-app paths on torrefranca.site
# SPA is a sample mount only; API lives on the main host (same idea as chart).

# Public sample UI path (trailing slash for Vite base)
AI_CRM_SAMPLE_BASE=/sample/ai-crm/
VITE_BASE=/sample/ai-crm/

# Main-site API mount (Passenger BaseURI). Not under /sample/.
AI_CRM_API_BASE=/api/ai-crm
VITE_API_BASE=/api/ai-crm

# Production on Z.com: Node Passenger app.js proxies to this upstream.
# AI_CRM_UPSTREAM_PORT=13096

# Runtime
AI_CRM_PASSENGER=0
AI_CRM_TRUST_PROXY=0
AI_CRM_MODEL=auto
AI_CRM_TRY_MAX=5
AI_CRM_DAILY_MAX=48
AI_CRM_GAP_MS=1500
AI_CRM_CORS_ORIGINS=https://torrefranca.site,http://127.0.0.1:3096,http://localhost:3096

# Prompt limits: always enforced on Passenger / production.
# Local PC only: put these in gitignored .env (not on the server):
#   AI_CRM_LOCAL_DEV=1
#   AI_CRM_LIMITS_ENABLED=0
AI_CRM_LIMITS_ENABLED=1
# AI_CRM_LOCAL_DEV=0
# AI_CRM_DISABLE_LIMITS=0

# Cursor keys (prefer a secrets file outside the repo)
# AI_CRM_ENV_FILE=/path/to/chart.env
# API_KEY1=
# CURSOR_API_KEY=
